# ─── app/ backend (see app/core/settings.py) ─────────────────────────
# local | staging | production. Anything but "local" requires SECRET_KEY and DATABASE_URL,
# disables the SQLite fallback, the default admin seed, and hashed KB embeddings.
APP_ENV=local
SECRET_KEY=
# Empty + APP_ENV=local: uses ./avnagent.db (SQLite). For Postgres (docker compose up -d), use a regular
# (non-superuser) role, since superusers bypass row-level security:
# DATABASE_URL=postgresql://avn_app:avn_app_password@127.0.0.1:5432/avnagent
DATABASE_URL=
# Comma-separated browser origins allowed to call the API (defaults to the Vite dev server when local)
CORS_ORIGINS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Tenant that owns inbound calls until numbers are mapped per tenant
DEFAULT_TENANT_ID=
# Optional first admin created on boot (local default: admin@company.com / adminpassword)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Encrypts credentials saved in data/config.json. Required outside local to save API keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Existing plain-text file: python -m scripts.encrypt_config
SECRETS_ENCRYPTION_KEY=
# Error tracking (optional)
SENTRY_DSN=
# Dashboard URL used in emailed links (local default: http://localhost:5173)
FRONTEND_URL=
# Email (Resend). Until both are set: local = emails printed to the API log; elsewhere = "not configured".
RESEND_API_KEY=
EMAIL_FROM=

# Core runtime
HOST=0.0.0.0
PORT=8000
AGENT_PORT=8081
APP_DATA_DIR=/app/data
APP_CONFIG_FILE=/app/data/config.json
KB_DATA_DIR=/app/data/kb
APP_BASE_URL=https://backend.example.com

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here
SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxxx
LIVEKIT_AGENT_NAME=vobiz-demo-agent

# Gemini / Google
GOOGLE_API_KEY=your_google_api_key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_TEMPERATURE=0.8
GEMINI_LIVE_LANGUAGE=
GEMINI_LIVE_PREFLIGHT_ENABLED=false
GEMINI_LIVE_PREFLIGHT_TIMEOUT=6
GEMINI_LIVE_CONNECT_TIMEOUT=20
GEMINI_LIVE_CONNECT_RETRIES=2
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
LANG_PRESET=multilingual

# Agent behavior
FIRST_LINE=Namaste! This is Aryan from AVN AI - we help businesses automate with AI. Hmm, may I ask what kind of business you run?
AGENT_INSTRUCTIONS=
MAX_TURNS=25
USER_AWAY_TIMEOUT=15
SESSION_CLOSE_TRANSCRIPT_TIMEOUT=2
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX
VOBIZ_SIP_DOMAIN=your_sip_domain.sip.vobiz.ai
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Knowledge base
KB_ENABLED=true
KB_TOP_K=4
KB_CONTEXT_CHAR_BUDGET=2800
KB_LIVE_TIMEOUT_MS=150
KB_LIVE_CONTEXT_CHAR_BUDGET=900
KB_CACHE_TTL_SECONDS=45
KB_CHUNK_SIZE=400
KB_CHUNK_OVERLAP=60
KB_WORKER_POLL_SECONDS=20
# Multilingual embeddings (768-d). gemini uses GOOGLE_API_KEY; "local" needs fastembed + a 768-d multilingual model.
KB_EMBEDDING_PROVIDER=gemini
KB_EMBEDDING_MODEL=gemini-embedding-001
# Cosine similarity a semantic-only match must reach (calibrated with python -m scripts.kb_multilingual_eval)
KB_MIN_DENSE_SIMILARITY=0.62

# Public base URL of the API (e.g. https://api.example.com), used for the lead-capture webhook URL
# and the calendar sign-in callbacks below.
PUBLIC_API_URL=

# Calendar sync. Each workspace's admin connects their own calendar from Appointments; these are the
# server's OAuth app credentials. Tokens are stored encrypted, so SECRETS_ENCRYPTION_KEY is required
# outside local development.
# Google Cloud console > APIs & Services: enable the Google Calendar API, create an OAuth client
# (Web application) with redirect URI  {PUBLIC_API_URL}/api/integrations/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Zoho API console (api-console.zoho.in): a Server-based client with redirect URI
# {PUBLIC_API_URL}/api/integrations/calendar/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Where Zoho sign-in starts; accounts in other data centres are redirected to their own automatically.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Paid plans. Plans and their Razorpay plan ids / Stripe price ids are listed in BILLING_PLANS_FILE
# (see configs/billing_plans.example.json). A provider is offered only when all three of its keys are set.
BILLING_PLANS_FILE=configs/billing_plans.json
# Razorpay (India): Dashboard > Account & Settings > API keys; webhook URL {PUBLIC_API_URL}/api/billing/webhook/razorpay
# with the subscription.* and invoice.* events and a secret of your choice.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (international): Developers > API keys; webhook endpoint {PUBLIC_API_URL}/api/billing/webhook/stripe with
# checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed and invoice.finalized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
